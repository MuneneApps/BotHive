cat > .gitignore << 'EOF'
# Dependencies
node_modules/

# Production build
build/

# Environment variables (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Mac system files
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor folders
.vscode/
.idea/

# Yarn
yarn.lock
EOF